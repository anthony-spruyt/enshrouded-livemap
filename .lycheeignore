# GitHub rate-limits unauthenticated requests (429 Too Many Requests)
https://github.com/.*
https://raw.githubusercontent.com/.*

# GitHub API URLs require authentication and can't be validated
https://api.github.com/.*

# VS Code site returns 403 to automated link checkers
https://code.visualstudio.com/.*

# VS Code Marketplace (intermittent 503s)
https://marketplace.visualstudio.com/

# SteamDB returns 403 to automated link checkers
https://steamdb\.info/app/2278520/depots/

# LAN server URLs use private .lan domains with shell variable substitution
.*\.lan/.*

# Internal MCP server hostname (not publicly accessible)
https://litellm/

# Localhost URLs are not reachable in CI/lint environments
http://localhost.*
https://localhost.*
http://127\.0\.0\.1.*
https://127\.0\.0\.1.*

# Schema store times out intermittently in CI
https://json\.schemastore\.org/.*

# Trivy docs site fails the TLS handshake (unrecognized name) intermittently
https://trivy\.dev/.*

# exe-capture.yaml's Steam info URL, built at runtime from APP_ID
https://api\.steamcmd\.net/v1/info/\$(\{|%7B)APP_ID(\}|%7D)

# exe-capture.yaml's registry URLs, built at runtime from the image path and build id
https://ghcr\.io/token\?service=ghcr\.io&scope=repository:\$(\{|%7B)path(\}|%7D):pull
https://ghcr\.io/v2/\$(\{|%7B)path(\}|%7D)/manifests/\$(\{|%7B)BUILD_ID(\}|%7D)

# Regex in release.yaml's upload URL check, not a link
^https://uploads/$
