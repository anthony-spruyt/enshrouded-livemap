# Turns data/builds.json into builds_generated.h, the tables src/scan.cpp and tools/selftest.cpp compile in.
# string(JSON) is all it needs, so build.cmd and the CI build gain no tool. Also runs as a script:
#   cmake -DBUILDS_JSON=<json> -DBUILDS_OUT=<header> -P cmake/builds.cmake

set(LIVEMAP_NAME_REGEX "^[a-z][a-z0-9_]*$")
set(LIVEMAP_HEX_REGEX "^0x[0-9a-f]+$")
set(LIVEMAP_BYTES_REGEX "^([0-9a-f][0-9a-f]|\\?\\?)( ([0-9a-f][0-9a-f]|\\?\\?))*$")

function(livemap_fail what)
    message(FATAL_ERROR "builds.json: ${what}")
endfunction()

function(livemap_json out json)
    string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
    if(error)
        livemap_fail("${error}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(livemap_json_has out json)
    string(JSON ignored ERROR_VARIABLE missing TYPE "${json}" ${ARGN})
    if(missing)
        set(${out} FALSE PARENT_SCOPE)
    else()
        set(${out} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(livemap_check value regex what)
    if(NOT value MATCHES "${regex}")
        livemap_fail("${what} '${value}' is malformed")
    endif()
endfunction()

function(livemap_camel out snake)
    livemap_check("${snake}" "^[a-z]+(_[a-z]+)*$" "mining_layout")
    string(REPLACE "_" ";" words "${snake}")
    set(camel "")
    foreach(word IN LISTS words)
        string(SUBSTRING "${word}" 0 1 head)
        string(SUBSTRING "${word}" 1 -1 tail)
        string(TOUPPER "${head}" head)
        string(APPEND camel "${head}${tail}")
    endforeach()
    set(${out} "${camel}" PARENT_SCOPE)
endfunction()

# Sets ${out} to the C++ entries {"name", 0xNu}, of the object at ${ARGN}, plus ${out}_count and ${out}_names.
function(livemap_named_entries out json)
    set(entries "")
    set(names "")
    string(JSON count LENGTH "${json}" ${ARGN})
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON name MEMBER "${json}" ${ARGN} ${i})
            livemap_check("${name}" "${LIVEMAP_NAME_REGEX}" "name")
            livemap_json(value "${json}" ${ARGN} "${name}")
            livemap_check("${value}" "${LIVEMAP_HEX_REGEX}" "${name}")
            string(APPEND entries "{\"${name}\", ${value}u}, ")
            list(APPEND names "${name}")
        endforeach()
    endif()
    set(${out} "${entries}" PARENT_SCOPE)
    set(${out}_count ${count} PARENT_SCOPE)
    set(${out}_names "${names}" PARENT_SCOPE)
endfunction()

function(livemap_generate_builds json_file out_header)
    file(READ "${json_file}" json)
    string(JSON set_count LENGTH "${json}" sigsets)
    string(JSON build_count LENGTH "${json}" builds)
    if(set_count EQUAL 0 OR build_count EQUAL 0)
        livemap_fail("needs at least one sigset and one build")
    endif()

    set(set_names "")
    set(body "")
    math(EXPR last_set "${set_count} - 1")
    foreach(si RANGE ${last_set})
        string(JSON set_name MEMBER "${json}" sigsets ${si})
        livemap_check("${set_name}" "${LIVEMAP_NAME_REGEX}" "sigset name")
        livemap_json(patterns "${json}" sigsets "${set_name}")
        string(JSON pattern_count LENGTH "${patterns}")
        if(pattern_count EQUAL 0)
            livemap_fail("sigset ${set_name} is empty")
        endif()
        list(APPEND set_names "${set_name}")
        set(sites "")
        set(operand_names "")
        set(rows "")
        math(EXPR last_pattern "${pattern_count} - 1")
        foreach(pi RANGE ${last_pattern})
            livemap_json(site "${patterns}" ${pi} site)
            livemap_json(bytes "${patterns}" ${pi} bytes)
            livemap_json(offset "${patterns}" ${pi} offset)
            string(JSON mandatory_type TYPE "${patterns}" ${pi} mandatory)
            livemap_check("${site}" "${LIVEMAP_NAME_REGEX}" "site name")
            livemap_check("${bytes}" "${LIVEMAP_BYTES_REGEX}" "${set_name}/${site} bytes")
            livemap_check("${offset}" "${LIVEMAP_HEX_REGEX}" "${set_name}/${site} offset")
            if(NOT mandatory_type STREQUAL "BOOLEAN")
                livemap_fail("${set_name}/${site} mandatory must be true or false")
            endif()
            if(site IN_LIST sites)
                livemap_fail("sigset ${set_name} lists ${site} twice")
            endif()
            list(APPEND sites "${site}")
            livemap_json(mandatory "${patterns}" ${pi} mandatory)
            if(mandatory)
                set(mandatory_cpp "true")
            else()
                set(mandatory_cpp "false")
            endif()
            set(operands_cpp "{}")
            livemap_json_has(has_operands "${patterns}" ${pi} operands)
            if(has_operands)
                livemap_named_entries(operands "${patterns}" ${pi} operands)
                if(operands_count GREATER 0)
                    string(APPEND body "inline constexpr Named kOperands_${si}_${pi}[] = {${operands}};\n")
                    set(operands_cpp "kOperands_${si}_${pi}")
                    list(APPEND operand_names ${operands_names})
                endif()
            endif()
            string(APPEND rows "    {.site = \"${site}\", .bytes = \"${bytes}\", .offset = ${offset}u, "
                ".mandatory = ${mandatory_cpp}, .operands = ${operands_cpp}},\n")
        endforeach()
        set(sites_${set_name} "${sites}")
        set(operand_names_${set_name} "${operand_names}")
        string(APPEND body "inline constexpr Pattern kPatterns_${si}[] = {\n${rows}};\n\n")
    endforeach()

    set(labels "")
    set(fingerprints "")
    set(build_rows "")
    math(EXPR last_build "${build_count} - 1")
    foreach(bi RANGE ${last_build})
        livemap_json(label "${json}" builds ${bi} label)
        livemap_json(stamp "${json}" builds ${bi} time_date_stamp)
        livemap_json(image_size "${json}" builds ${bi} size_of_image)
        livemap_json(set_name "${json}" builds ${bi} sigset)
        livemap_json(layout "${json}" builds ${bi} mining_layout)
        livemap_check("${label}" "^[0-9a-z_.-]+$" "label")
        livemap_check("${stamp}" "^[0-9]+$" "${label} time_date_stamp")
        livemap_check("${image_size}" "${LIVEMAP_HEX_REGEX}" "${label} size_of_image")
        if(stamp GREATER 4294967295)
            livemap_fail("${label} time_date_stamp does not fit 32 bits")
        endif()
        list(FIND set_names "${set_name}" set_index)
        if(set_index LESS 0)
            livemap_fail("${label} uses sigset ${set_name}, which is not defined")
        endif()
        if(label IN_LIST labels)
            livemap_fail("label ${label} is used twice")
        endif()
        set(fingerprint "${stamp}/${image_size}")
        if(fingerprint IN_LIST fingerprints)
            livemap_fail("${label} has the TimeDateStamp and SizeOfImage of another build")
        endif()
        list(APPEND labels "${label}")
        list(APPEND fingerprints "${fingerprint}")
        livemap_camel(layout_cpp "${layout}")

        # Ordered like the sigset, so the selftest reports in the order the scan checks.
        livemap_json(expected "${json}" builds ${bi} expected)
        string(JSON expected_count LENGTH "${expected}")
        set(entries "")
        set(matched 0)
        foreach(site IN LISTS sites_${set_name})
            livemap_json_has(has_site "${expected}" "${site}")
            if(has_site)
                livemap_json(rva "${expected}" "${site}")
                livemap_check("${rva}" "${LIVEMAP_HEX_REGEX}" "${label} expected ${site}")
                string(APPEND entries "{\"${site}\", ${rva}u}, ")
                math(EXPR matched "${matched} + 1")
            endif()
        endforeach()
        if(NOT matched EQUAL expected_count)
            math(EXPR last_expected "${expected_count} - 1")
            foreach(ei RANGE ${last_expected})
                string(JSON name MEMBER "${expected}" ${ei})
                if(NOT name IN_LIST sites_${set_name})
                    livemap_fail("${label} expects ${name}, which sigset ${set_name} does not have")
                endif()
            endforeach()
        endif()
        set(expected_cpp "{}")
        if(matched GREATER 0)
            string(APPEND body "inline constexpr Named kExpected_${bi}[] = {${entries}};\n")
            set(expected_cpp "kExpected_${bi}")
        endif()

        set(expected_operands_cpp "{}")
        livemap_json_has(has_expected_operands "${json}" builds ${bi} expected_operands)
        if(has_expected_operands)
            livemap_named_entries(expected_operands "${json}" builds ${bi} expected_operands)
            foreach(name IN LISTS expected_operands_names)
                if(NOT name IN_LIST operand_names_${set_name})
                    livemap_fail("${label} expects operand ${name}, which sigset ${set_name} does not have")
                endif()
            endforeach()
            if(expected_operands_count GREATER 0)
                string(APPEND body "inline constexpr Named kExpectedOperands_${bi}[] = {${expected_operands}};\n")
                set(expected_operands_cpp "kExpectedOperands_${bi}")
            endif()
        endif()

        string(APPEND build_rows
            "    {.label = \"${label}\", .time_date_stamp = ${stamp}u, .size_of_image = ${image_size}u,\n"
            "     .sigset = &kSigsets[${set_index}], .mining_layout = MiningLayout::${layout_cpp},\n"
            "     .expected = ${expected_cpp}, .expected_operands = ${expected_operands_cpp}},\n")
    endforeach()

    set(sigset_rows "")
    foreach(si RANGE ${last_set})
        list(GET set_names ${si} set_name)
        string(APPEND sigset_rows "    {\"${set_name}\", kPatterns_${si}},\n")
    endforeach()

    string(CONCAT content
        "// Generated by cmake/builds.cmake from data/builds.json. Do not edit.\n"
        "#pragma once\n\n#include \"builds.h\"\n\nnamespace livemap {\n\n"
        "${body}"
        "inline constexpr Sigset kSigsets[] = {\n${sigset_rows}};\n\n"
        "inline constexpr Build kBuilds[] = {\n${build_rows}};\n\n"
        "}  // namespace livemap\n")
    file(CONFIGURE OUTPUT "${out_header}" CONTENT "${content}" @ONLY)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    livemap_generate_builds("${BUILDS_JSON}" "${BUILDS_OUT}")
endif()
