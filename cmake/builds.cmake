# Turns data/builds.json into builds_generated.h, the tables src/scan.cpp and tools/selftest.cpp compile in.
#   cmake -DBUILDS_JSON=<json> -DBUILDS_OUT=<header> -P cmake/builds.cmake

set(LIVEMAP_NAME_REGEX "^[a-z][a-z0-9_]*$")
set(LIVEMAP_HEX_REGEX "^0x(0|[1-9a-f][0-9a-f]*)$")
set(LIVEMAP_ID_REGEX "^[1-9][0-9]*$")
set(LIVEMAP_LABEL_REGEX "^[0-9a-z_.-]+$")
set(LIVEMAP_BYTES_REGEX "^([0-9a-f][0-9a-f]|\\?\\?)( ([0-9a-f][0-9a-f]|\\?\\?))*$")
# Keep in step with data/builds.schema.json and MiningLayout in src/mining.h.
set(LIVEMAP_LAYOUTS inline_array stack_record)
# The sites world::install hooks whatever the sigset says; the scan fails closed without them.
set(LIVEMAP_INSTALLED_SITES player_table movement daytime registry)
set(LIVEMAP_JOIN_SITE join_line)

function(livemap_fail what)
    message(FATAL_ERROR "builds.json: ${what}")
endfunction()

function(livemap_in_list out value)
    list(FIND ARGN "${value}" index)
    if(index LESS 0)
        set(${out} FALSE PARENT_SCOPE)
    else()
        set(${out} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(livemap_json_has out json)
    string(JSON ignored ERROR_VARIABLE missing TYPE "${json}" ${ARGN})
    if(missing)
        set(${out} FALSE PARENT_SCOPE)
    else()
        set(${out} TRUE PARENT_SCOPE)
    endif()
endfunction()

# Sets ${out} to the value at ${ARGN} in ${json}, which must have the JSON type ${type}.
function(livemap_get out type what json)
    string(JSON actual ERROR_VARIABLE error TYPE "${json}" ${ARGN})
    if(error OR NOT actual STREQUAL type)
        if(type STREQUAL "BOOLEAN")
            livemap_fail("${what} must be true or false")
        elseif(type STREQUAL "OBJECT")
            livemap_fail("${what} must be an object")
        elseif(type STREQUAL "ARRAY")
            livemap_fail("${what} must be an array")
        else()
            string(TOLOWER "${type}" article)
            livemap_fail("${what} must be a ${article}")
        endif()
    endif()
    string(JSON value GET "${json}" ${ARGN})
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# The object at ${ARGN} may only have the members in ${allowed} and has to have those in ${required}.
function(livemap_members what json allowed required)
    livemap_get(object OBJECT "${what}" "${json}" ${ARGN})
    string(JSON count LENGTH "${object}")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON name MEMBER "${object}" ${i})
            livemap_in_list(known "${name}" ${allowed})
            if(NOT known)
                livemap_fail("${what} has the unknown member '${name}'")
            endif()
        endforeach()
    endif()
    foreach(name IN LISTS required)
        livemap_json_has(present "${object}" "${name}")
        if(NOT present)
            livemap_fail("${what} lacks '${name}'")
        endif()
    endforeach()
endfunction()

function(livemap_check value regex what)
    if(NOT value MATCHES "${regex}")
        livemap_fail("${what} '${value}' is malformed")
    endif()
endfunction()

function(livemap_check_short value regex max_length what)
    string(LENGTH "${value}" length)
    if(NOT value MATCHES "${regex}" OR length GREATER ${max_length})
        livemap_fail("${what} '${value}' is malformed")
    endif()
endfunction()

function(livemap_hex what value)
    livemap_check_short("${value}" "${LIVEMAP_HEX_REGEX}" 10 "${what}")
endfunction()

function(livemap_id what value)
    livemap_check_short("${value}" "${LIVEMAP_ID_REGEX}" 20 "${what}")
endfunction()

function(livemap_camel out snake)
    string(REPLACE "_" ";" words "${snake}")
    set(camel "")
    foreach(word IN LISTS words)
        string(SUBSTRING "${word}" 0 1 head)
        string(SUBSTRING "${word}" 1 -1 tail)
        string(TOUPPER "${head}" head)
        string(APPEND camel "${head}${tail}")
    endforeach()
    set(${out} "${camel}" PARENT_SCOPE)
endfunction()

# Sets ${out} to the C++ entries {"name", 0xNu}, of the object at ${ARGN}, plus ${out}_count, ${out}_names and ${out}_values.
function(livemap_named_entries out what json)
    livemap_get(object OBJECT "${what}" "${json}" ${ARGN})
    set(entries "")
    set(names "")
    set(values "")
    string(JSON count LENGTH "${object}")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON name MEMBER "${object}" ${i})
            livemap_check("${name}" "${LIVEMAP_NAME_REGEX}" "name")
            livemap_get(value STRING "${name}" "${object}" "${name}")
            livemap_hex("${name}" "${value}")
            string(APPEND entries "{\"${name}\", ${value}u}, ")
            list(APPEND names "${name}")
            list(APPEND values "${value}")
        endforeach()
    endif()
    set(${out} "${entries}" PARENT_SCOPE)
    set(${out}_count ${count} PARENT_SCOPE)
    set(${out}_names "${names}" PARENT_SCOPE)
    set(${out}_values "${values}" PARENT_SCOPE)
endfunction()

function(livemap_generate_builds json_file out_header)
    file(READ "${json_file}" json)
    string(FIND "${json}" "\\u0000" nul)
    if(NOT nul EQUAL -1)
        livemap_fail("contains a \\u0000 escape")
    endif()
    livemap_members("the document" "${json}" "$schema;sigsets;builds" "sigsets;builds")
    livemap_json_has(has_schema "${json}" "$schema")
    if(has_schema)
        livemap_get(ignored STRING "$schema" "${json}" "$schema")
    endif()
    livemap_get(sigsets OBJECT "sigsets" "${json}" sigsets)
    livemap_get(builds ARRAY "builds" "${json}" builds)
    string(JSON set_count LENGTH "${sigsets}")
    string(JSON build_count LENGTH "${builds}")
    if(set_count EQUAL 0)
        livemap_fail("needs at least one sigset")
    endif()
    if(build_count EQUAL 0)
        livemap_fail("needs at least one build")
    endif()

    set(set_names "")
    set(body "")
    math(EXPR last_set "${set_count} - 1")
    foreach(si RANGE ${last_set})
        string(JSON set_name MEMBER "${sigsets}" ${si})
        livemap_check("${set_name}" "${LIVEMAP_NAME_REGEX}" "sigset name")
        livemap_get(patterns ARRAY "sigset ${set_name}" "${sigsets}" "${set_name}")
        string(JSON pattern_count LENGTH "${patterns}")
        if(pattern_count EQUAL 0)
            livemap_fail("sigset ${set_name} is empty")
        endif()
        list(APPEND set_names "${set_name}")
        set(sites "")
        set(mandatory_sites "")
        set(operand_names "")
        set(rows "")
        math(EXPR last_pattern "${pattern_count} - 1")
        foreach(pi RANGE ${last_pattern})
            set(where "sigset ${set_name} pattern ${pi}")
            livemap_members("${where}" "${patterns}" "site;bytes;offset;mandatory;operands"
                "site;bytes;offset;mandatory" ${pi})
            livemap_get(site STRING "${where} site" "${patterns}" ${pi} site)
            livemap_check("${site}" "${LIVEMAP_NAME_REGEX}" "site name")
            set(where "${set_name}/${site}")
            livemap_get(bytes STRING "${where} bytes" "${patterns}" ${pi} bytes)
            livemap_get(offset STRING "${where} offset" "${patterns}" ${pi} offset)
            livemap_get(mandatory BOOLEAN "${where} mandatory" "${patterns}" ${pi} mandatory)
            livemap_check("${bytes}" "${LIVEMAP_BYTES_REGEX}" "${where} bytes")
            livemap_hex("${where} offset" "${offset}")
            string(LENGTH "${bytes}" bytes_length)
            math(EXPR byte_count "(${bytes_length} + 1) / 3")
            math(EXPR offset_value "${offset}")
            if(offset_value GREATER byte_count)
                livemap_fail("${where} offset ${offset} is past the end of its ${byte_count} pattern bytes")
            endif()
            livemap_in_list(listed "${site}" ${sites})
            if(listed)
                livemap_fail("sigset ${set_name} lists ${site} twice")
            endif()
            list(APPEND sites "${site}")
            if(mandatory)
                set(mandatory_cpp "true")
                list(APPEND mandatory_sites "${site}")
            else()
                set(mandatory_cpp "false")
            endif()
            set(operands_cpp "{}")
            livemap_json_has(has_operands "${patterns}" ${pi} operands)
            if(has_operands)
                livemap_named_entries(operands "${where} operands" "${patterns}" ${pi} operands)
                # The code reads each operand as 4 bytes.
                set(operand_index 0)
                foreach(operand IN LISTS operands_names)
                    list(GET operands_values ${operand_index} operand_offset)
                    math(EXPR operand_end "${operand_offset} + 4")
                    if(operand_end GREATER byte_count)
                        livemap_fail("${where} operand ${operand} at ${operand_offset} reads past the end of its ${byte_count} pattern bytes")
                    endif()
                    math(EXPR operand_index "${operand_index} + 1")
                endforeach()
                if(operands_count GREATER 0)
                    string(APPEND body "inline constexpr Named kOperands_${si}_${pi}[] = {${operands}};\n")
                    set(operands_cpp "kOperands_${si}_${pi}")
                    list(APPEND operand_names ${operands_names})
                endif()
            endif()
            string(APPEND rows "    {.site = \"${site}\", .bytes = \"${bytes}\", .offset = ${offset}u, "
                ".mandatory = ${mandatory_cpp}, .operands = ${operands_cpp}},\n")
        endforeach()
        foreach(installed IN LISTS LIVEMAP_INSTALLED_SITES)
            livemap_in_list(is_mandatory "${installed}" ${mandatory_sites})
            if(NOT is_mandatory)
                livemap_fail("sigset ${set_name} does not list '${installed}' as mandatory, and the DLL always hooks it")
            endif()
        endforeach()
        set(sites_${set_name} "${sites}")
        set(operand_names_${set_name} "${operand_names}")
        string(APPEND body "inline constexpr Pattern kPatterns_${si}[] = {\n${rows}};\n\n")
    endforeach()

    string(REPLACE ";" ", " layout_list "${LIVEMAP_LAYOUTS}")
    set(labels "")
    set(fingerprints "")
    set(build_ids "")
    set(used_sets "")
    set(build_rows "")
    math(EXPR last_build "${build_count} - 1")
    foreach(bi RANGE ${last_build})
        livemap_members("build ${bi}" "${builds}"
            "label;buildids;time_date_stamp;size_of_image;sigset;mining_layout;steam;expected;expected_operands"
            "label;buildids;time_date_stamp;size_of_image;sigset;mining_layout;steam;expected" ${bi})
        livemap_get(label STRING "build ${bi} label" "${builds}" ${bi} label)
        livemap_check_short("${label}" "${LIVEMAP_LABEL_REGEX}" 32 "label")
        set(where "build ${label}")
        livemap_get(stamp NUMBER "${where} time_date_stamp" "${builds}" ${bi} time_date_stamp)
        livemap_get(image_size STRING "${where} size_of_image" "${builds}" ${bi} size_of_image)
        livemap_get(set_name STRING "${where} sigset" "${builds}" ${bi} sigset)
        livemap_get(layout STRING "${where} mining_layout" "${builds}" ${bi} mining_layout)
        livemap_check("${stamp}" "^(0|[1-9][0-9]*)$" "${label} time_date_stamp")
        if(stamp GREATER 4294967295)
            livemap_fail("${label} time_date_stamp does not fit 32 bits")
        endif()
        livemap_hex("${label} size_of_image" "${image_size}")
        list(FIND set_names "${set_name}" set_index)
        if(set_index LESS 0)
            livemap_fail("${label} uses sigset ${set_name}, which is not defined")
        endif()
        livemap_in_list(known_layout "${layout}" ${LIVEMAP_LAYOUTS})
        if(NOT known_layout)
            livemap_fail("${label} mining_layout '${layout}' is not one of ${layout_list}")
        endif()
        livemap_in_list(label_used "${label}" ${labels})
        if(label_used)
            livemap_fail("label ${label} is used twice")
        endif()
        math(EXPR size_value "${image_size}")
        set(fingerprint "${stamp}/${size_value}")
        livemap_in_list(fingerprint_used "${fingerprint}" ${fingerprints})
        if(fingerprint_used)
            livemap_fail("${label} has the TimeDateStamp and SizeOfImage of another build")
        endif()
        if(DEFINED layout_of_${set_name} AND NOT layout_of_${set_name} STREQUAL layout)
            livemap_fail("builds ${first_build_of_${set_name}} and ${label} share sigset ${set_name} but not the mining layout")
        endif()
        set(layout_of_${set_name} "${layout}")
        if(NOT DEFINED first_build_of_${set_name})
            set(first_build_of_${set_name} "${label}")
        endif()
        list(APPEND used_sets "${set_name}")
        list(APPEND labels "${label}")
        list(APPEND fingerprints "${fingerprint}")
        livemap_camel(layout_cpp "${layout}")

        livemap_get(ids ARRAY "${where} buildids" "${builds}" ${bi} buildids)
        string(JSON id_count LENGTH "${ids}")
        if(id_count EQUAL 0)
            livemap_fail("${where} has no buildids")
        endif()
        math(EXPR last_id "${id_count} - 1")
        foreach(ii RANGE ${last_id})
            livemap_get(id STRING "${where} buildid" "${ids}" ${ii})
            livemap_id("${where} buildid" "${id}")
            livemap_in_list(id_used "${id}" ${build_ids})
            if(id_used)
                livemap_fail("build id ${id} is used twice")
            endif()
            list(APPEND build_ids "${id}")
        endforeach()

        livemap_members("${where} steam" "${builds}" "depot;manifest;exe_sha256" "depot;manifest;exe_sha256" ${bi} steam)
        foreach(key IN ITEMS depot manifest exe_sha256)
            string(JSON kind TYPE "${builds}" ${bi} steam ${key})
            if(kind STREQUAL "NULL")
                continue()
            endif()
            if(NOT kind STREQUAL "STRING")
                livemap_fail("${where} steam ${key} must be a string or null")
            endif()
            string(JSON text GET "${builds}" ${bi} steam ${key})
            if(key STREQUAL "exe_sha256")
                string(LENGTH "${text}" text_length)
                if(NOT text MATCHES "^[0-9a-f]+$" OR NOT text_length EQUAL 64)
                    livemap_fail("${where} steam ${key} '${text}' is malformed")
                endif()
            else()
                livemap_id("${where} steam ${key}" "${text}")
            endif()
        endforeach()

        # Ordered like the sigset, so the selftest reports in the order the scan checks.
        livemap_get(expected OBJECT "${where} expected" "${builds}" ${bi} expected)
        string(JSON expected_count LENGTH "${expected}")
        if(expected_count GREATER 0)
            math(EXPR last_expected "${expected_count} - 1")
            foreach(ei RANGE ${last_expected})
                string(JSON name MEMBER "${expected}" ${ei})
                if(name STREQUAL LIVEMAP_JOIN_SITE)
                    livemap_fail("${label} expects ${name}, which is not a hook site")
                endif()
                livemap_in_list(in_sigset "${name}" ${sites_${set_name}})
                if(NOT in_sigset)
                    livemap_fail("${label} expects ${name}, which sigset ${set_name} does not have")
                endif()
                livemap_get(rva STRING "${label} expected ${name}" "${expected}" "${name}")
                livemap_hex("${label} expected ${name}" "${rva}")
            endforeach()
        endif()
        set(entries "")
        set(matched 0)
        foreach(site IN LISTS sites_${set_name})
            livemap_json_has(has_site "${expected}" "${site}")
            if(has_site)
                string(JSON rva GET "${expected}" "${site}")
                string(APPEND entries "{\"${site}\", ${rva}u}, ")
                math(EXPR matched "${matched} + 1")
            endif()
        endforeach()
        foreach(installed IN LISTS LIVEMAP_INSTALLED_SITES)
            livemap_json_has(has_installed "${expected}" "${installed}")
            if(NOT has_installed)
                livemap_fail("${label} expects no RVA for '${installed}', which the DLL always hooks")
            endif()
        endforeach()
        set(expected_cpp "{}")
        if(matched GREATER 0)
            string(APPEND body "inline constexpr Named kExpected_${bi}[] = {${entries}};\n")
            set(expected_cpp "kExpected_${bi}")
        endif()

        set(expected_operands_cpp "{}")
        livemap_json_has(has_expected_operands "${builds}" ${bi} expected_operands)
        if(has_expected_operands)
            livemap_named_entries(expected_operands "${where} expected_operands" "${builds}" ${bi} expected_operands)
            foreach(name IN LISTS expected_operands_names)
                livemap_in_list(has_operand "${name}" ${operand_names_${set_name}})
                if(NOT has_operand)
                    livemap_fail("${label} expects operand ${name}, which sigset ${set_name} does not have")
                endif()
            endforeach()
            if(expected_operands_count GREATER 0)
                string(APPEND body "inline constexpr Named kExpectedOperands_${bi}[] = {${expected_operands}};\n")
                set(expected_operands_cpp "kExpectedOperands_${bi}")
            endif()
        endif()

        string(APPEND build_rows
            "    {.label = \"${label}\", .time_date_stamp = ${stamp}u, .size_of_image = ${image_size}u,\n"
            "     .sigset = &kSigsets[${set_index}], .mining_layout = MiningLayout::${layout_cpp},\n"
            "     .expected = ${expected_cpp}, .expected_operands = ${expected_operands_cpp}},\n")
    endforeach()

    set(sigset_rows "")
    foreach(si RANGE ${last_set})
        list(GET set_names ${si} set_name)
        livemap_in_list(set_used "${set_name}" ${used_sets})
        if(NOT set_used)
            livemap_fail("sigset ${set_name} is not used by any build")
        endif()
        string(APPEND sigset_rows "    {\"${set_name}\", kPatterns_${si}},\n")
    endforeach()

    set(installed_cpp "")
    foreach(installed IN LISTS LIVEMAP_INSTALLED_SITES)
        string(APPEND installed_cpp "\"${installed}\", ")
    endforeach()

    string(CONCAT content
        "// Generated by cmake/builds.cmake from data/builds.json. Do not edit.\n"
        "#pragma once\n\n#include \"builds.h\"\n\nnamespace livemap {\n\n"
        "${body}"
        "inline constexpr Sigset kSigsets[] = {\n${sigset_rows}};\n\n"
        "inline constexpr Build kBuilds[] = {\n${build_rows}};\n\n"
        "inline constexpr const char* kInstalledSites[] = {${installed_cpp}};\n\n"
        "}  // namespace livemap\n")
    file(CONFIGURE OUTPUT "${out_header}" CONTENT "${content}" @ONLY)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    livemap_generate_builds("${BUILDS_JSON}" "${BUILDS_OUT}")
endif()
