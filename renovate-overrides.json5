{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Dependency bumps in files that go into the release zip or the compat tool release as a patch, because release-please hides chore commits. CI, test and dev tooling stay chore",
      "matchFileNames": [
        "CMakeLists.txt",
        "cmake/**",
        "data/**",
        "package/**",
        "src/**",
        "tools/compat/**",
        "web/**"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    }
  ]
}
